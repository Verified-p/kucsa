{
  "version": 2,

  "builds": [
    {
      "src": "kucsa_platform/wsgi.py",
      "use": "@vercel/python"
    }
  ],

  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },

    {
      "src": "/media/(.*)",
      "dest": "/media/$1"
    },

    {
      "src": "/(.*)",
      "dest": "kucsa_platform/wsgi.py"
    }
  ]
}