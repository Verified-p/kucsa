@login_required
def expenses(request):
    """
    Display expenses with an optional status filter.
    """
    _require_permission(
        request.user,
        can_view_expenses,
    )

    queryset = (
        Expense.objects
        .select_related(
            "category",
            "recorded_by",
            "submitted_by",
            "approved_by",
            "paid_by",
        )
        .order_by(
            "-expense_date",
            "-created_at",
        )
    )

    status = request.GET.get("status")

    if status:
        queryset = queryset.filter(
            status=status,
        )

    return render(
        request,
        "finance/expenses.html",
        {
            "expenses": queryset,

            "expense_statuses": (
                Expense.ExpenseStatus.choices
            ),

            "selected_status": status,
        },
    )


@login_required
def expense_detail(request, pk):
    """
    Display a single expense and its audit history.
    """
    _require_permission(
        request.user,
        can_view_expenses,
    )

    expense = get_object_or_404(
        Expense.objects.select_related(
            "category",
            "transaction",
            "recorded_by",
            "submitted_by",
            "approved_by",
            "rejected_by",
            "paid_by",
