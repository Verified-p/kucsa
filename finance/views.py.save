# APPROVE EXPENSE
# =============================================================================

@login_required
def expense_approve(request, pk):
    """
    Approve a submitted expense.
    """
    _require_permission(
        request.user,
        can_manage_finance,
    )

    if request.method != "POST":
        return redirect(
            "finance:expense_detail",
            pk=pk,
        )

    expense = get_object_or_404(
        Expense,
        pk=pk,
    )

    try:
        approve_expense(
            user=request.user,
            expense=expense,
        )

        messages.success(
            request,
            "Expense approved successfully.",
